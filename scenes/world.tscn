[node name="WorldNPC_Mara" parent="NPCs" unique_id=1021890887 instance=ExtResource("9_npc")]
position = Vector2(-460, -765)
npc_id = "npc_mara"
portrait = ExtResource("20_mara")
dialogue_lines = Array[String](["Hi! I'm Mara, island caretaker.", "Pick up trash and bring it back. I'll reward good work!", "Glass fetches the best price; I like tidy shores!"])
repeat_dialogue_lines = Array[String](["Welcome back! Got any Polyethylene to spare?", "Oda's clock story again? Wheels, tides, the whole almanac. It is a calendar, not a chronometer.", "They say someone watches from the far point. Nobody has caught them yet."])
quest_complete_lines = Array[String](["You're a true island hero!"])
tier2_lines = Array[String](["Tier 2: bring 5 Glass for a Polypropylene bounty."])
milestone_beats = {"tide_keeper": "Two and a half thousand on the Pact — you really believe in this place. So do I. Always did.", "island_steward": "Every badge, every page. The island has never had a keeper like you, and it knows it.", "loop_master": "Twenty-five circuits. The island routes itself through you now.", "clean_sweep": "Five dives with not a fish bumped and not a gram wasted. The reef is lucky you are patient."}
quest_material = "Polyethylene"
quest_amount = 8
quest_reward_mat = "Glass"
quest_reward_amount = 3
quest2_material = "Glass"
quest2_amount = 5
quest2_reward_mat = "Polypropylene"
quest2_reward_amount = 8

[node name="WorldNPC_Tom" parent="NPCs" unique_id=1692442811 instance=ExtResource("9_npc")]
position = Vector2(-689, -1150)
npc_id = "npc_tom"
portrait = ExtResource("21_tom")
npc_name = "Tom"
npc_sprite_index = 2
dialogue_lines = Array[String](["The reef is full of drifting junk.", "Bring it back for recycling!"])
repeat_dialogue_lines = Array[String](["Any Nylon for the shop today?", "Wheels, tides, a brass heart. Fine. My grandfather said the island ticks, too. I never corrected him.", "They say someone watches from the far point — Oda sees him. I keep to my fishing."])
quest_complete_lines = Array[String](["Sea life thanks you!"])
tier2_lines = Array[String](["Tier 2: 6 Polypropylene for 8 Polyethylene."])
reward_trash = 4
reward_mat = "Nylon"
milestone_beats = {"tide_messages": "You read my note? I never sign them properly — glad it helped. The fish came back; that is all that matters.", "island_steward": "Full journal, full tide, full heart. Whatever you came here to find — you found it.", "heavy_haul": "Thirty kilos in one dive? The reef noticed that. Try not to rob it.", "reef_veteran": "Twenty-five dives and you still come up smiling. Most of us stop smiling at the third.", "reef_abyss": "Nine hundred metres down. The reef keeps its deepest secrets, and lets you walk right past."}
quest_material = "Nylon"
quest_amount = 6
quest_reward_mat = "Polypropylene"
quest_reward_amount = 6
quest2_material = "Polypropylene"
quest2_amount = 6
quest2_reward_amount = 8

[node name="WorldNPC_Nina" parent="NPCs" unique_id=822166491 instance=ExtResource("9_npc")]
position = Vector2(-292, 861)
npc_id = "npc_nina"
portrait = ExtResource("22_nina")
npc_name = "Nina"
npc_sprite_index = 3
dialogue_lines = Array[String](["I run the recycling stand near the shop.", "Sell trash for coins; I'll pay a bonus!"])
repeat_dialogue_lines = Array[String](["Got stock for the store today?", "A clock you cannot sell shelf space in is just furniture, love. Although it does tick in four time signatures."])
quest_complete_lines = Array[String](["Shop's stocked! Thanks."])
tier2_lines = Array[String](["Tier 2: 8 Polyethylene for 8 Polypropylene."])
reward_trash = 5
reward_mat = "Nylon"
milestone_beats = {"tide_messages": "I heard you found the letters. Every single one. Somewhere up there the glass gardens are catching the light just for you.", "island_steward": "They will tell stories about you at the stand. The ones with every badge do not come along often.", "silk_touch": "Five flawless shifts and not a bin missed. At the stand we have a word for that — we use it rarely, and the word is ‘yes’.", "far_point": "Word travels that you saw the one on the far point. Nobody at the counter speaks of it. We count it as true anyway."}
quest_material = "Glass"
quest_amount = 6
quest_reward_mat = "Polypropylene"
quest_reward_amount = 6
quest2_material = "Polyethylene"
quest2_amount = 8
quest2_reward_mat = "Polypropylene"
quest2_reward_amount = 8

[node name="WorldNPC_Kai" parent="NPCs" unique_id=200355740 instance=ExtResource("9_npc")]
position = Vector2(1019, -1164)
npc_id = "npc_kai"
portrait = ExtResource("23_kai")
npc_name = "Kai"
npc_sprite_index = 4
milestone_beats = {"tide_keeper": "The Pact. Two and a half grand. The tidekeeper pays attention to who does that — so do I. Shelves are always open to you.", "island_steward": "Every achievement in the book, and not one shelf left untouched. You are the best customer I have ever had.", "whispers": "Corl whispered you seven days of weather and you paid for every one. I have never understood him. The till never turns him down, though.", "silent_chorus": "Read every note the sea ever slipped you. I stock for people like you — and you are the only regular who buys nothing before reading everything first.", "golden_touch": "Ten golden finds. The reef has never been this shiny in any ledger of mine."}
dialogue_lines = Array[String](["I run the shop across the way.", "Bring me Glass and I'll stock the shelves!"])
repeat_dialogue_lines = Array[String](["Any Glass for the shop today?", "Oda claims the island is a disassembled clock. Marketing opportunity, if the sea ever wants shelf space."])
quest_complete_lines = Array[String](["Shelves fully stocked. Thank you!"])
tier2_lines = Array[String](["Tier 2: 8 Polyethylene for 4 Glass."])
reward_trash = 3
reward_mat = "Polypropylene"
quest_material = "Glass"
quest_amount = 5
quest_reward_mat = "Polypropylene"
quest_reward_amount = 6
quest2_material = "Polyethylene"
quest2_amount = 8
quest2_reward_mat = "Glass"
quest2_reward_amount = 4

[node name="WorldNPC_Oda" parent="NPCs" unique_id=900000026 instance=ExtResource("9_npc")]
position = Vector2(-560, -725)
npc_id = "npc_oda"
npc_name = "Oda"
npc_sprite_index = 2
dialogue_lines = Array[String](["Name's Oda. I keep the island's almanac — every tide the sea has, I write it down.", "The sea turns through four moods over four days. Nobody knows the order until it arrives.", "Watch the water, keeper. It always tells the truth eventually."])
repeat_dialogue_lines = Array[String](["The almanac's a little fatter every week. Come see what today's sea has decided.", "Inside cover says the island was a brass clock once — four wheels, four tides. Kai calls it bad inventory timing. I call it history."])
flavour_variants = Array[String](["Four tides, four warnings.", "The almanac's a little fatter every week.", "Slack water gifts the patient."])
ambient_bubbles = Array[String](["*scribbling in a salt-stained book*", "*holds a hand up to the wind*"])
reward_trash = 0
reward_mat = "Polyethylene"
tide_aware = true
milestone_beats = {"keeper_letter": "Found his note, did you? He stood right about there. Watched the same water you do.", "island_steward": "Every page of the journal, every badge the island has. I have watched a lot of keepers pass through — you are the first I would write down.", "whispers": "Seven days of tomorrow from Corl, and he still will not take a compliment. The sea made him this way — I respect it. Mostly.", "silent_chorus": "Six voices the water ever had, and you heard every one. Half the keepers think the tide is weather. You know better now.", "long_keeper": "Ten tides on one island. Staying is the whole job, love. You stayed.", "steady_keeper": "Three tides running. You show up. That is the whole trick.", "far_point": "You saw him. I do not ask how you knew he was there. Some of us watch the water. Some of us are watched by it."}


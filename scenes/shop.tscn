[node name="Tip" type="Label" parent="CanvasLayer/Scroll/VBoxContainer"]
layout_mode = 2
modulate = Color(0.95, 0.9, 0.5, 1.0)
text = "Tip: sort efficiently for combo bonuses."
name = "Tip"

[node name="CapacityStatus" type="Label" parent="CanvasLayer/Scroll/VBoxContainer"]
custom_minimum_size = Vector2(520, 0)
text = "Capacity: 0/0 kg"
modulate = Color(0.8, 0.95, 1.0, 1.0)

[node name="TransactionLog" type="Label" parent="CanvasLayer/Scroll/VBoxContainer"]

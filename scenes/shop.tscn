[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/shop_menu.gd" id="1_shop"]

[node name="Shop" type="Node2D"]
script = ExtResource("1_shop")

[node name="CanvasLayer" type="CanvasLayer" parent="."]
follow_viewport_enabled = false

[node name="Background" type="ColorRect" parent="CanvasLayer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.12, 0.14, 0.2, 1.0)

[node name="Scroll" type="ScrollContainer" parent="CanvasLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 20.0
offset_right = -20.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0

[node name="VBoxContainer" type="VBoxContainer" parent="CanvasLayer/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 5

[node name="Title" type="Label" parent="CanvasLayer/Scroll/VBoxContainer"]
layout_mode = 2
text = "Shop (sell trash)"
theme_override_font_sizes/font_size = 24

[node name="Coins" type="Label" parent="CanvasLayer/Scroll/VBoxContainer"]
layout_mode = 2
text = "Score: 0"
name = "Coins"

[node name="Purchases" type="VBoxContainer" parent="CanvasLayer/Scroll/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="PurchasesTitle" type="Label" parent="CanvasLayer/Scroll/VBoxContainer/Purchases"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Spend money"

[node name="BuyRow" type="HBoxContainer" parent="CanvasLayer/Scroll/VBoxContainer/Purchases"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BuyCapButton" type="Button" parent="CanvasLayer/Scroll/VBoxContainer/Purchases/BuyRow"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
text = "Bag +10 kg — 60$"

[node name="MoneyNote" type="Label" parent="CanvasLayer/Scroll/VBoxContainer/Purchases"]
layout_mode = 2
modulate = Color(0.8, 0.95, 1, 1)
theme_override_font_sizes/font_size = 14
text = ""

[node name="Inventory" type="Label" parent="CanvasLayer/Scroll/VBoxContainer"]
layout_mode = 2
text = "Inventory: "

[gd_scene load_steps=2 format=3 uid="uid://slot_picker_scene"]

[ext_resource type="Script" path="res://scripts/ui/slot_picker.gd" id="1_picker"]
[ext_resource type="Script" path="res://scripts/ui/drag_scroll.gd" id="2_drag"]

[sub_resource type="StyleBoxFlat" id="StyleBox_slotbg"]
content_margin_left = 24.0
content_margin_top = 20.0
content_margin_right = 24.0
content_margin_bottom = 20.0
bg_color = Color(0.05, 0.08, 0.12, 0.95)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.4, 0.7, 0.9, 0.5)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16

[node name="SlotPicker" type="CanvasLayer"]
process_mode = 3
layer = 180
script = ExtResource("1_picker")

[node name="Dimmer" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.55)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(680, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBox_slotbg")

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Center/Panel/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.7, 0.92, 1, 1)
theme_override_font_sizes/font_size = 26
text = "Choose an island"

[node name="NewSlotBtn" type="Button" parent="Center/Panel/VBox/Header"]
custom_minimum_size = Vector2(190, 48)
layout_mode = 2
text = "+ New island"

[node name="EmptyHint" type="Label" parent="Center/Panel/VBox"]
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.7, 0.8, 1)
theme_override_font_sizes/font_size = 24
text = "No islands yet — start one with the button above."
autowrap_mode = 3

[node name="ListScroll" type="ScrollContainer" parent="Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 360)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
overlay_scroll_horizontal = false
overlay_scroll_vertical = false
script = ExtResource("2_drag")

[node name="SlotList" type="VBoxContainer" parent="Center/Panel/VBox/ListScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Footer" type="HBoxContainer" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="FooterHint" type="Label" parent="Center/Panel/VBox/Footer"]
layout_mode = 2
size_flags_horizontal = 3
vertical_alignment = 1
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(0.68, 0.78, 0.86, 0.85)
text = "Islands save automatically — quitting never costs progress."

[node name="CloseBtn" type="Button" parent="Center/Panel/VBox/Footer"]
custom_minimum_size = Vector2(190, 48)
layout_mode = 2
size_flags_horizontal = 3
text = "Cancel"

[connection signal="pressed" from="Center/Panel/VBox/Header/NewSlotBtn" to="." method="_on_new_slot"]
[connection signal="pressed" from="Center/Panel/VBox/Footer/CloseBtn" to="." method="_on_close"]
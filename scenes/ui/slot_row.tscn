[gd_scene load_steps=2 format=3 uid="uid://slot_row_scene"]

[ext_resource type="Script" path="res://scripts/ui/slot_row.gd" id="1_row"]

[sub_resource type="StyleBoxFlat" id="StyleBox_row"]
content_margin_left = 16.0
content_margin_top = 12.0
content_margin_right = 16.0
content_margin_bottom = 12.0
bg_color = Color(0.08, 0.12, 0.18, 0.85)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3, 0.55, 0.75, 0.4)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="SlotRow" type="PanelContainer"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("StyleBox_row")
script = ExtResource("1_row")

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Icon" type="Label" parent="HBox"]
layout_mode = 2
custom_minimum_size = Vector2(36, 0)
theme_override_colors/font_color = Color(0.55, 0.85, 1.0, 1.0)
theme_override_font_sizes/font_size = 26
text = "🏝"

[node name="VBox" type="VBoxContainer" parent="HBox"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 2

[node name="NameRow" type="HBoxContainer" parent="HBox/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Name" type="Label" parent="HBox/VBox/NameRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.9, 0.95, 1.0, 1.0)
theme_override_font_sizes/font_size = 20
autowrap_mode = 3
text = "Island"

[node name="EditBtn" type="Button" parent="HBox/VBox/NameRow"]
custom_minimum_size = Vector2(36, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "✎"

[node name="DelBtn" type="Button" parent="HBox/VBox/NameRow"]
custom_minimum_size = Vector2(36, 36)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "✕"

[node name="Meta" type="Label" parent="HBox/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.72, 0.85, 1.0)
theme_override_font_sizes/font_size = 20
autowrap_mode = 3
text = "a fresh shore"

[node name="PickBtn" type="Button" parent="HBox"]
custom_minimum_size = Vector2(120, 48)
layout_mode = 2
size_flags_vertical = 1
theme_override_font_sizes/font_size = 20
text = "Load island"

[connection signal="pressed" from="PickBtn" to="." method="_on_pick"]
[connection signal="pressed" from="EditBtn" to="." method="_on_edit"]
[connection signal="pressed" from="DelBtn" to="." method="_on_delete"]
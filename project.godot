; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="isle2"
config/description="a second very trash island"
run/main_scene="uid://cc0ngv5xr7xwg"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"
SaveManager="*res://scripts/save_manager.gd"
AudioManager="*res://scenes/audio_manager.tscn"
GameSettings="*res://scripts/game_settings.gd"
SceneTransition="*res://scripts/scene_transition.gd"
TutorialDirector="*res://scripts/tutorial_director.gd"
MCPGameBridge="res://scripts/mcp_bridge_guard.gd"

[display]

window/stretch/mode="viewport"

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[godot_mcp]

bind_mode=0
custom_bind_ip=""
port_override_enabled=false
port_override=6550

[gui]

theme/custom="uid://b3lluk0kntgej"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true

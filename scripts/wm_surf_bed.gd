extends AudioStreamPlayer
class_name SurfBed

## Continuous surf under the world map. A 12 s seamless wash generated by
## tools/make_surf.py, looped on its own dedicated player so the round-robin SFX
## pool can never cut it off mid-swell. Fades in on world entry, survives the
## pause menu (PROCESS_MODE_ALWAYS), and routes through the Ambience bus so the
## player can trim the wash without touching one-shot SFX. Audio-only, so
## reduced motion does not mute the water.

const SURF_PATH := "res://sound/sfx/surf.wav"

@export var target_db: float = -22.0
@export var fade_in_seconds: float = 3.0
@export var bus_name: StringName = &"Ambience"


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	bus = bus_name
	stream = load(SURF_PATH)
	if stream == null:
		push_warning("SurfBed: missing %s" % SURF_PATH)
		return
	
	_force_loop()
	volume_db = -60.0
	play()
	
	var fade := create_tween()
	fade.tween_property(self, "volume_db", target_db, fade_in_seconds).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)


## The generated WAV carries no loop chunk, so the importer leaves the stream as
## a one-shot. Wrap the whole buffer here rather than relying on import settings.
func _force_loop() -> void:
	if not (stream is AudioStreamWAV):
		return
	var wav := stream as AudioStreamWAV
	wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
	wav.loop_begin = 0
	# Derive the frame count from the playback length, not the raw buffer: the
	# importer may hand us a compressed stream whose `data` is not PCM frames.
	wav.loop_end = int(round(wav.get_length() * float(wav.mix_rate)))
